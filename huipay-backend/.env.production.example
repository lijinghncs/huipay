# =============================================================================
# HuiPay Backend - 生产环境配置模板
# 用法：复制为 .env.production 并填写真实值（或部署平台注入这些环境变量）。
# 注意：本文件仅示例，严禁提交真实密钥/证书到仓库。
# 配置项与 infra/config/config.go 的 env 前缀 HUIPAY_* 一一对应。
# =============================================================================

# ---------------------------------------------------------------
# 应用通用配置
# ---------------------------------------------------------------
HUIPAY_HTTP_PORT=8080
HUIPAY_GIN_MODE=release
HUIPAY_LOG_LEVEL=info
HUIPAY_APP_NAME=huipay-backend
HUIPAY_APP_ENV=production

# ---------------------------------------------------------------
# MySQL 主从 DSN（生产建议使用内网地址 + 强密码，勿用默认）
# ---------------------------------------------------------------
HUIPAY_MYSQL_MASTER="user:strong_password@tcp(127.0.0.1:3306)/huipay?charset=utf8mb4&parseTime=True&loc=Local"
HUIPAY_MYSQL_SLAVE=""

# =============================================================================
# 微信支付 V3 配置（HUIPAY_WECHAT_*）
# 以下的 10 个参数为收款/回调闭环必需，投产前必须全部填齐。
# =============================================================================

# 1. 是否启用微信支付通道（必须为 true 才会注册通道与回调处理器）
HUIPAY_WECHAT_ENABLED=true

# 2. 微信支付商户号（微信商户平台 -> 账户中心 -> 商户信息）
HUIPAY_WECHAT_MCHID=<请填写商户号，如 1900000000>

# 3. 公众号/小程序 AppID
HUIPAY_WECHAT_APPID=<请填写 AppID，如 wx8888888888888888>

# 4. 公众号/小程序 AppSecret（OAuth 换 openid 用，JSAPI/H5 支付必须）
HUIPAY_WECHAT_APP_SECRET=<请填写 AppSecret>

# 5. APIv3 密钥（32 字节字符串，回调解密 + JSAPI 二次签名用）
HUIPAY_WECHAT_API_V3_KEY=<请填写 32 位 APIv3 密钥>

# 6. 商户 API 证书序列号（商户平台 -> API 安全 -> 管理 API 证书）
HUIPAY_WECHAT_MERCHANT_SERIAL_NO=<请填写商户证书序列号>

# 7. 商户 API 私钥（PEM 文件 apiclient_key.pem 的内容，多行）
#    部署时可用: HUIPAY_WECHAT_MERCHANT_PRIVATE_KEY="$(cat /path/apiclient_key.pem)"
HUIPAY_WECHAT_MERCHANT_PRIVATE_KEY=<请填写 apiclient_key.pem 的完整内容>

# 8. 微信平台证书序列号（商户平台 -> API 安全 -> 微信支付平台证书）
HUIPAY_WECHAT_PLATFORM_SERIAL_NO=<请填写平台证书序列号>

# 9. 微信平台证书公钥（对应平台证书的公钥 PEM 内容，验签用）
HUIPAY_WECHAT_PLATFORM_PUBLIC_KEY=<请填写平台证书公钥 PEM>

# 10. 回调地址前缀（HTTPS 公网域名，需已 ICP 备案且在商户平台配置为支付回调域名）
#     回调接口: {notify_base_url}/v1/notify/wechat 与 {notify_base_url}/v1/notify/wechat/refund
HUIPAY_WECHAT_NOTIFY_BASE_URL=<请填写公网域名，如 https://checkout.huipay.cn>

# ---------------------------------------------------------------
# 可选配置（一般无需修改）
# ---------------------------------------------------------------
# 微信支付 API 基础地址，默认 https://api.mch.weixin.qq.com（sandbox 环境可切换）
# HUIPAY_WECHAT_BASE_URL=https://api.mch.weixin.qq.com

# =============================================================================
# 投产前必做核对清单
# =============================================================================
# 1. HUIPAY_WECHAT_ENABLED=true，且 10 个 WECHAT_* 参数全部非空。
# 2. 商户平台已配置支付回调域名（与 HUIPAY_WECHAT_NOTIFY_BASE_URL 一致）。
# 3. 商户私钥/平台公钥/APIv3Key 通过部署平台 Secret 注入，严禁入库/提交。
# 4. 平台证书轮换：当前为静态证书（StaticCertProvider），证书过期后需人工更新
#    PLATFORM_SERIAL_NO / PLATFORM_PUBLIC_KEY，建议尽快接入自动拉取 /v3/certificates。
# 5. 分账能力尚未实现（Split/ReturnSplit/FinishSplit 为空），微信侧资金不会真正分出，
#    如涉及分账请先落地 /v3/profitsharing 后再准出。
# 6. 退款回调目前仅验签+log，未做钱包反向入账，退款账务闭环需在 P2 补齐。